{
  "name": "@octichq/airlock-sdk",
  "version": "0.2.0",
  "private": false,
  "description": "Agent telemetry for Node, for Airlock. Stamps the Octic attribute contract onto OpenTelemetry spans and writes them to a local spool. Brings no instrumentation of its own.",
  "keywords": [
    "octic",
    "airlock",
    "opentelemetry",
    "otel",
    "telemetry",
    "observability",
    "llm",
    "agents",
    "genai"
  ],
  "homepage": "https://github.com/OcticHQ/telemetry/tree/main/node#readme",
  "bugs": {
    "url": "https://github.com/OcticHQ/telemetry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OcticHQ/telemetry.git",
    "directory": "node"
  },
  "license": "Apache-2.0",
  "author": "Octic.ai",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml 'test/*.test.ts'",
    "lint": "eslint . --cache --cache-strategy content",
    "lint:fix": "eslint . --cache --cache-strategy content --fix",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "pack:check": "npm run build && publint && attw --pack . --ignore-rules cjs-resolves-to-esm"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/otlp-transformer": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-trace": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "import-in-the-middle": "^3.3.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
